<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Meine Sucht ❤️</title>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        :root {
            --primary: #e91e63;
            --secondary: #f48fb1;
            --bg-soft: #fff0f6;
            --text-main: #880e4f;
        }

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #fce4ec;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            transition: background-image 1.2s ease-in-out;
            color: var(--text-main);
            text-align: center;
            padding: 20px;
            margin: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Floating Hearts Animation Background */
        .heart-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        .container {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 40px 25px;
            border-radius: 30px;
            box-shadow: 0 15px 35px rgba(233, 30, 99, 0.15);
            max-width: 450px;
            width: 90%;
            margin: auto;
            border: 1px solid rgba(244, 143, 177, 0.3);
            position: relative;
        }

        #musicControl {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: white;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 2px solid var(--primary);
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            font-size: 20px;
        }

        h1 { font-size: 1.8em; margin-bottom: 15px; color: var(--primary); }
        p { line-height: 1.6; font-size: 1.05em; }

        input {
            padding: 15px;
            font-size: 16px;
            border: 2px solid var(--secondary);
            border-radius: 15px;
            width: 85%;
            margin-bottom: 20px;
            outline: none;
            text-align: center;
            transition: border-color 0.3s;
        }
        input:focus { border-color: var(--primary); }

        button {
            background: linear-gradient(135deg, var(--primary), #ff4081);
            color: white;
            border: none;
            padding: 14px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            margin: 10px 5px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 5px 15px rgba(233, 30, 99, 0.3);
        }
        button:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 8px 20px rgba(233, 30, 99, 0.4); }
        button:active { transform: translateY(0); }

        .hidden { display: none; }
        
        .card { 
            border: 1.5px solid var(--secondary); 
            padding: 25px; 
            margin-top: 20px; 
            border-radius: 20px; 
            background: rgba(255, 240, 246, 0.8); 
            text-align: left;
            font-family: 'Georgia', serif;
            font-size: 1rem;
        }

        .fade-in { animation: fadeIn 0.8s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        /* Gallery Grid */
        .gallery {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin: 20px 0;
        }
        .gallery img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 15px;
            border: 3px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        #hintBtn { background: var(--secondary); font-size: 13px; }

        .error-shake {
            animation: shake 0.4s;
            color: #d32f2f;
            font-weight: bold;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            75% { transform: translateX(6px); }
        }
    </style>
</head>
<body>

<div class="heart-bg" id="heartContainer"></div>

<audio id="bgMusic" loop>
    <source src="https://www.bensound.com/bensound-music/bensound-love.mp3" type="audio/mpeg">
</audio>

<div id="musicControl" class="hidden" onclick="toggleMusic()">🎵</div>

<!-- Password Entry -->
<div id="loginSection" class="container fade-in">
    <h1>🔒 Classified Access</h1>
    <p>Please enter the secret decryption key to enter the birthday portal, Mamie🥰❤️</p>
    <input type="password" id="passwordInput" placeholder="Nickname or secret code...">
    <br>
    <button onclick="checkPassword()">Unlock Portal</button>
    <p id="errorMsg" class="hidden">Access Denied! Think of our nicknames or our day... 🤫</p>
</div>

<!-- Home Menu -->
<div id="menuSection" class="container hidden">
    <h1>Happy Birthday, Valentine! 🎂</h1>
    <p>Welcome to your personal portal, <i>Meine Sucht</i>.</p>
    <button onclick="showNote()">💌 Read The Note</button>
    <button onclick="startGame()">🎮 The Love Quiz</button>
    <button onclick="showGallery()">📸 Mood Gallery</button>
</div>

<!-- The Letter -->
<div id="noteSection" class="container hidden">
    <h1>To My Favorite Human</h1>
    <div class="card">
        <p>Happy Birthday, my beautiful <strong>Valentine</strong>!</p>
        <p>From our late-night calls to the playful "violence" we promise each other daily, you have become my favorite addiction (<em>Meine Sucht</em>). Even when you’re threatening to “end my bloodline” or making me eat burnt food, I wouldn’t trade a single second with you for anything—not even for 24/7 ZESA or unlimited Data! 😂</p>
        <p>I promise to be right there to watch <em>Big Brother</em> with you (even if I complain the whole time😂😂), to help you ignore the “bread abuse,” and to always be your peace and love you exactly the way you deserve to be loved.</p>
        <p>Enjoy your special day, my love. Always remember: even if I lose the fight, I still win every time because I have you by my side.</p>
        <p><strong>I love you more than you love sleeping! ❤️</strong></p>
        <p>Happy Birthday 🎂🥳 my love. I wish you a lifetime of happiness, and I can’t wait to see your <strong>grey hair</strong> grow in while I’m still right here with you.</p>
    </div>
    <br>
    <button onclick="goBack()">⬅️ Back to Menu</button>
</div>

<!-- Photo Gallery -->
<div id="gallerySection" class="container hidden">
    <h1>Our Moments</h1>
    <div class="gallery">
        <!-- These are placeholder images - replace the URLs with your own photos! -->
        <img src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&q=60&w=400" alt="Moment 1">
        <img src="https://images.unsplash.com/photo-1516589174184-c684846b4743?auto=format&fit=crop&q=60&w=400" alt="Moment 2">
        <img src="https://images.unsplash.com/photo-1523438885200-e635ba2c371e?auto=format&fit=crop&q=60&w=400" alt="Moment 3">
        <img src="https://images.unsplash.com/photo-1494972308805-463bc619d34e?auto=format&fit=crop&q=60&w=400" alt="Moment 4">
    </div>
    <p><i>Building a lifetime of memories...</i></p>
    <button onclick="goBack()">⬅️ Back to Menu</button>
</div>

<!-- Love Quiz Game -->
<div id="gameSection" class="container hidden">
    <h1>The Love Quiz 🕵️‍♀️</h1>
    <div id="quizContainer"></div>
    <div id="final" class="hidden">
        <h2>🎉 Certified Smart! 🎉</h2>
        <p>You are officially the smartest Gangster I know.</p>
        <p>I owe you a jar of coffee! (The non-Elephant one) 😂</p>
        <button onclick="goBack()">⬅️ Back to Menu</button>
    </div>
</div>

<script>
    const music = document.getElementById("bgMusic");
    const musicBtn = document.getElementById("musicControl");

    function toggleMusic() {
        if (music.paused) {
            music.play();
            musicBtn.innerHTML = "⏸️";
        } else {
            music.pause();
            musicBtn.innerHTML = "🎵";
        }
    }

    // Function to generate floating hearts background
    function createHeart() {
        const heart = document.createElement("div");
        heart.innerHTML = "❤️";
        heart.style.position = "fixed";
        heart.style.left = Math.random() * 100 + "vw";
        heart.style.top = "100vh";
        heart.style.fontSize = (Math.random() * 20 + 15) + "px";
        heart.style.opacity = Math.random();
        heart.style.zIndex = "-1";
        heart.style.transition = "transform 6s linear, opacity 6s";
        document.getElementById("heartContainer").appendChild(heart);

        setTimeout(() => {
            heart.style.transform = `translateY(-110vh) rotate(${Math.random() * 360}deg)`;
            heart.style.opacity = "0";
        }, 100);

        setTimeout(() => heart.remove(), 7000);
    }
    
    // Start background animation
    setInterval(createHeart, 450);

    const questions = [
        { q: "1. What is the fastest mode of transport we agreed on?", a: "broom" },
        { q: "2. What is the meal we abuse?", a: "bread" },
        { q: "3. What metaphor made me feel 'stupid' for not understanding?", a: "bridge" },
        { q: "4. Who is the true love of your life? (Be honest)", a: "grey's anatomy" },
        { q: "5. Who did you spend all of December 26th talking to?", a: "granny" },
        { q: "6. Where is your favourite place to 'groove'?", a: "home" },
        { q: "7. What is the name of our child?", a: "dragon" }
    ];

    let currentQ = 0;
    let attempts = 0;

    function checkPassword() {
        const input = document.getElementById("passwordInput").value.toLowerCase().trim();
        const error = document.getElementById("errorMsg");
        
        // Password logic
        if (input === "beeshark" || input === "23") {
            document.getElementById("loginSection").classList.add("hidden");
            document.getElementById("menuSection").classList.remove("hidden");
            document.getElementById("menuSection").classList.add("fade-in");
            musicBtn.classList.remove("hidden");
            
            // Try to play music (might be blocked by browser till first interaction)
            music.play().catch(() => console.log("Music blocked by browser policy"));
            musicBtn.innerHTML = "⏸️";
            
            // Big confetti burst
            confetti({
                particleCount: 150,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#e91e63', '#ffffff', '#f48fb1']
            });
        } else {
            error.classList.remove("hidden");
            error.classList.add("error-shake");
            setTimeout(() => error.classList.remove("error-shake"), 400);
        }
    }

    function startGame() {
        showSection("gameSection");
        document.getElementById("quizContainer").classList.remove("hidden");
        document.getElementById("final").classList.add("hidden");
        currentQ = 0;
        loadQuestion();
    }

    function loadQuestion() {
        if (currentQ >= questions.length) {
            document.getElementById("quizContainer").classList.add("hidden");
            document.getElementById("final").classList.remove("hidden");
            confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            return;
        }
        attempts = 0;
        renderQuestion();
    }

    function renderQuestion() {
        const container = document.getElementById("quizContainer");
        let hintHtml = attempts >= 3 ? `<br><button id="hintBtn" onclick="showTheAnswer()">Reveal Answer</button>` : '';
        
        container.innerHTML = `
            <div class="fade-in">
                <p><strong>${questions[currentQ].q}</strong></p>
                <input type="text" id="answerInput" placeholder="Your answer...">
                <br>
                <button onclick="checkAnswer()">Submit Answer</button>
                ${hintHtml}
            </div>
        `;
    }

    function checkAnswer() {
        const inputField = document.getElementById("answerInput");
        const userAns = inputField.value.toLowerCase().trim();
        
        if (userAns.includes(questions[currentQ].a)) {
            currentQ++;
            loadQuestion();
        } else {
            attempts++;
            alert("Aah ahh! Try again, my love! 😂");
            if (attempts >= 3) {
                renderQuestion(); 
            }
        }
    }

    function showTheAnswer() {
        alert("Psst... the answer is: " + questions[currentQ].a.toUpperCase());
    }

    function showSection(id) {
        document.querySelectorAll('.container').forEach(c => c.classList.add('hidden'));
        const el = document.getElementById(id);
        el.classList.remove('hidden');
        el.classList.add('fade-in');
    }

    function showNote() { showSection("noteSection"); }
    function showGallery() { showSection("gallerySection"); }
    function goBack() { showSection("menuSection"); }

</script>
</body>
</html>

